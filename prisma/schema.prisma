generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-1.0.x"]
}


datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  phone             String?                 @unique
  username          String                  @unique
  password          String
  displayName       String?
  avatarColor       String                  @default("#2E9BEA")
  avatarImage       String?
  role              String                  @default("user") // user | admin
  createdAt         DateTime                @default(now())
  wallet            Wallet?
  games             GamePlayer[]
  messages          Message[]
  paymentRequests   PaymentRequest[]
  tournamentEntries TournamentParticipant[]
  orders            MarketplaceOrder[]
}


model Product {
  id          String             @id @default(cuid())
  name        String
  description String?
  price       Decimal
  imageUrl    String?
  stock       Int                @default(0)
