generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  phone              String?                 @unique
  username           String                  @unique
  password           String
  displayName        String?
  avatarColor        String                  @default("#2E9BEA")
  avatarImage        String?
  role               String                  @default("user") // user | admin
  createdAt          DateTime                @default(now())
  wallet             Wallet?
  games              GamePlayer[]
  messages           Message[]
  paymentRequests    PaymentRequest[]
  tournamentEntries  TournamentParticipant[]
  orders             MarketplaceOrder[]
  productsForSale    Product[]
  sellerApplications SellerApplication[]
  cartOrders         CartOrder[]
  /// Vrai si la dernière demande de vendeur a été validée par un admin —
  /// condition pour pouvoir publier des annonces sur la boutique.
  isApprovedSeller   Boolean                 @default(false)
  /// Solde Karataka Points (cache de la somme des PointTransaction) — modifié
  /// uniquement par PointsService, jamais depuis l'app.
  points             Int                     @default(0)
  pointTxns          PointTransaction[]
  following          SellerFollow[]          @relation("follower")
  followers          SellerFollow[]          @relation("followedSeller")
  productShares      ProductShare[]
  /// Magasin partenaire / vendeur mis en avant par l'admin (accueil, boutique).
  isPartner          Boolean                 @default(false)
  /// Courte présentation du magasin partenaire, saisie par l'admin.
  partnerDescription String?
  /// Code de parrainage personnel, et parrain éventuel (bonus de points).
  referralCode       String?                 @unique
  referredById       String?
  notifications      Notification[]
  devices            DeviceToken[]
}

/// Notification affichée dans l'app (cloche) et envoyée sur le téléphone
/// (Firebase) si l'appareil est enregistré.
model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  /// order | seller | payment | tournament | game | follow | admin | system
  type      String   @default("system")
  title     String
  body      String
  /// JSON facultatif pour ouvrir le bon écran (ex. {"orderId":"..."}).
  data      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

/// Jeton Firebase Cloud Messaging d'un téléphone (notifications push).
model DeviceToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  platform  String   @default("android")
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Ligne d'historique Karataka Points. `refKey` (unique) rend chaque
/// attribution idempotente : une même partie / commande ne rapporte qu'une fois.
model PointTransaction {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  amount    Int
  /// chess_win | chess_play | purchase | tournament_join | share_product | admin
  reason    String
  refKey    String   @unique
  label     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, reason, createdAt])
}

/// Abonnement d'un utilisateur à un vendeur (« Suivre »).
model SellerFollow {
  id         String   @id @default(cuid())
  follower   User     @relation("follower", fields: [followerId], references: [id])
  followerId String
  seller     User     @relation("followedSeller", fields: [sellerId], references: [id])
  sellerId   String
  createdAt  DateTime @default(now())

  @@unique([followerId, sellerId])
  @@index([sellerId])
}

/// Partage d'un produit (Facebook, WhatsApp, lien…) — statistiques vendeur
/// et base des points de partage plafonnés.
model ProductShare {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  channel   String   @default("native") // native | facebook | whatsapp | copy
  createdAt DateTime @default(now())

  @@index([productId])
}

model Product {
  id            String             @id @default(cuid())
  name          String
  description   String?
  price         Decimal
  /// Prix barré affiché quand `isPromo` est vrai (ex-prix avant réduction).
  originalPrice Decimal?
  isPromo       Boolean            @default(false)
  imageUrl      String?
  stock         Int                @default(0)
  active        Boolean            @default(true)
  category      String?            @default("general")
  sellerName    String?            @default("Tsenabe officiel")
  /// Vendeur réel (marketplace multi-vendeur) — `null` pour les produits
  /// officiels historiques (sellerName sert alors d'affichage seul).
  sellerId      String?
  seller        User?              @relation(fields: [sellerId], references: [id])
  createdAt     DateTime           @default(now())
  orders        MarketplaceOrder[]
  cartItems     CartOrderItem[]
  photo         ProductPhoto?
  shares        ProductShare[]

  @@index([active, createdAt])
  @@index([sellerId])
}

/// Photo envoyée depuis le téléphone du vendeur (base64), servie par
/// GET /marketplace/products/:id/image — séparée pour ne pas alourdir les listes.
model ProductPhoto {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id])
  mimeType  String  @default("image/jpeg")
  data      String
}

model MarketplaceOrder {
  id               String   @id @default(cuid())
  product          Product  @relation(fields: [productId], references: [id])
  productId        String
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  amount           Decimal
  /// Commission plateforme prélevée sur cette vente (5 % du montant), déjà
  /// déduite du virement reçu par le vendeur.
  commissionAmount Decimal  @default("0")
  status           String   @default("paid")
  createdAt        DateTime @default(now())
}

/// Dossier de candidature vendeur : CIN + photo CIN + selfie avec CIN +
/// numéro MVola. Un admin valide/refuse avant que le compte ne puisse
/// publier des annonces (`User.isApprovedSeller`).
model SellerApplication {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  cinNumber   String
  cinPhotoUrl String
  selfieUrl   String
  mvolaNumber String
  status      String    @default("pending") // pending | approved | rejected
  reviewNote  String?
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
}

/// Commande panier boutique : plusieurs articles + livraison, en attente de
/// validation admin avant débit réel du portefeuille (même logique de
/// confiance que les demandes de paiement MVola manuelles).
model CartOrder {
  id               String          @id @default(cuid())
  user             User            @relation(fields: [userId], references: [id])
  userId           String
  deliveryName     String
  deliveryPhone    String
  deliveryAddress  String
  deliveryCity     String
  /// Position GPS du client (optionnelle, « ma position actuelle »).
  deliveryLat      Float?
  deliveryLng      Float?
  deliveryFee      Decimal
  itemsTotal       Decimal
  commissionAmount Decimal         @default("0")
  /// pending (attente validation admin) | approved (attente de livraison)
  /// | delivered (achat terminé) | rejected
  status           String          @default("pending")
  /// mvola | cash (paiement à la livraison)
  paymentMethod    String          @default("cash")
  paymentPhone     String?
  paymentReference String?
  deliveredAt      DateTime?
  reviewNote       String?
  createdAt        DateTime        @default(now())
  reviewedAt       DateTime?
  items            CartOrderItem[]
}

model CartOrderItem {
  id        String    @id @default(cuid())
  order     CartOrder @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product   @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Decimal
  sellerId  String?
}

/// Lot d'enchère — géré exclusivement par un admin. Aucune donnée fictive :
/// tant qu'aucun lot n'existe, l'écran Enchères affiche « à bientôt ».
model AuctionLot {
  id              String       @id @default(cuid())
  title           String
  description     String?
  imageUrl        String?
  startingBid     Decimal
  currentBid      Decimal
  currentBidderId String?
  status          String       @default("active") // active | ended
  endsAt          DateTime
  createdAt       DateTime     @default(now())
  bids            AuctionBid[]
}

model AuctionBid {
  id        String     @id @default(cuid())
  lot       AuctionLot @relation(fields: [lotId], references: [id])
  lotId     String
  userId    String
  amount    Decimal
  createdAt DateTime   @default(now())
}

/// Contenu de la Foire (ventes flash / stands) — géré par un admin. Vide par
/// défaut : l'écran affiche « pas encore d'événement » tant qu'aucun n'existe.
model FairEvent {
  id            String    @id @default(cuid())
  title         String
  description   String?
  imageUrl      String?
  price         Decimal
  originalPrice Decimal?
  stock         Int       @default(0)
  category      String    @default("flash") // flash | stand
  active        Boolean   @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
}

/// Bannière publicitaire de l'accueil — 100 % gérée par l'admin ; l'écran
/// n'affiche rien tant qu'aucune bannière active n'existe.
model HomeBanner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkType  String? // 'tab' | 'url'
  linkValue String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/// Version d'application publiée — sert la mise à jour in-app (l'app compare
/// sa version locale à la plus récente ici et propose le téléchargement).
model AppRelease {
  id          String   @id @default(cuid())
  platform    String   @default("android")
  version     String
  buildNumber Int
  apkUrl      String
  notes       String?
  mandatory   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// Demande de dépôt/retrait MVola manuelle (le joueur envoie l'argent lui-même
/// via *111# vers le numéro caisse, indique une référence, puis un admin
/// valide — crédite/débite alors réellement le portefeuille).
model PaymentRequest {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  type       String // deposit | withdraw
  amount     Decimal
  reference  String? // référence MVola ou note fournie par le joueur
  phone      String?
  status     String    @default("pending") // pending | approved | rejected
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?
}

model Wallet {
  id      String        @id @default(cuid())
  user    User?         @relation(fields: [userId], references: [id])
  userId  String?       @unique
  balance Decimal       @default("0")
  txns    Transaction[]
}

model Transaction {
  id        String   @id @default(cuid())
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  walletId  String
  amount    Decimal
  type      String // deposit | withdraw | bet | payout | fee
  meta      String?
  createdAt DateTime @default(now())
}

model Game {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  matches   Match[]
}

model Match {
  id        String       @id @default(cuid())
  game      Game         @relation(fields: [gameId], references: [id])
  gameId    String
  state     String
  betAmount Decimal      @default("0")
  winnerId  String?
  createdAt DateTime     @default(now())
  players   GamePlayer[]
}

model GamePlayer {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  match   Match  @relation(fields: [matchId], references: [id])
  matchId String
  side    String
}

model Tournament {
  id               String                  @id @default(cuid())
  name             String
  entryFee         Decimal
  startsAt         DateTime
  createdAt        DateTime                @default(now())
  /// Le bracket (rounds + horaires) n'est généré qu'une fois, sur demande —
  /// évite de re-tirer au sort les paires à chaque consultation.
  bracketGenerated Boolean                 @default(false)
  /// Créateur : lui seul peut lancer le tournoi (bracket) une fois complet.
  /// `null` pour les tournois historiques → réservés à l'admin.
  createdById      String?
  /// Nombre de places ; le lancement n'est possible que tournoi complet.
  maxParticipants  Int                     @default(8)
  /// chess | checkers | fanorona
  game             String                  @default("chess")
  /// open (inscriptions) | started (bracket lancé) | finished
  status           String                  @default("open")
  participants     TournamentParticipant[]
  matches          TournamentMatch[]
}

/// Une confrontation du bracket : ronde, deux joueurs (ou une place vacante
/// « bye »/à déterminer), horaire prévu et résultat une fois joué.
model TournamentMatch {
  id           String     @id @default(cuid())
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String
  round        Int
  /// Position dans la ronde — sert à retrouver le match suivant du bracket
  /// (position `i` de la ronde `r` alimente la position `i/2` de `r+1`).
  position     Int
  player1Id    String?
  player2Id    String?
  winnerId     String?
  scheduledAt  DateTime
  status       String     @default("scheduled") // scheduled | done

  @@unique([tournamentId, round, position])
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  joinedAt     DateTime   @default(now())

  @@unique([tournamentId, userId])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  content   String
  createdAt DateTime @default(now())
}

/// Note de satisfaction (1 à 5) laissée par un client pour un vendeur, une
/// fois sa commande livrée. Une seule note par commande et par vendeur
/// (modifiable par le client).
model SellerReview {
  id        String   @id @default(cuid())
  orderId   String
  sellerId  String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, sellerId])
  @@index([sellerId, createdAt])
}

/// Offre d'emploi publiée par l'admin sous forme d'affiche (image), visible
/// dans l'onglet Emplois.
model JobOffer {
  id          String   @id @default(cuid())
  title       String?
  description String?
  contact     String?
  mimeType    String   @default("image/jpeg")
  imageData   String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active, createdAt])
}

/// Page Facebook (ou compte TikTok) reliée au compte vendeur. Le jeton de
/// page reste côté serveur et n'est jamais renvoyé à l'app.
model SocialAccount {
  id          String   @id @default(cuid())
  userId      String
  platform    String
  pageId      String
  pageName    String
  accessToken String
  createdAt   DateTime @default(now())

  @@unique([userId, platform])
}

/// Publication demandée par un vendeur sur sa page, publiée seulement après
/// validation par un admin. pending | published | failed | rejected
model SocialPost {
  id         String    @id @default(cuid())
  sellerId   String
  productId  String
  platform   String
  message    String
  status     String    @default("pending")
  externalId String?
  error      String?
  reviewNote String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
  @@index([sellerId, createdAt])
}

/// Bonus quotidien (roue) : un tirage par jour et par compte.
model DailySpin {
  id        String   @id @default(cuid())
  userId    String
  day       String
  prize     Int
  streak    Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, day])
}
