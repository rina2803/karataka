generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  username          String                  @unique
  password          String
  displayName       String?
  avatarColor       String                  @default("#2E9BEA")
  avatarImage       String?
  role              String                  @default("user") // user | admin
  createdAt         DateTime                @default(now())
  wallet            Wallet?
  games             GamePlayer[]
  messages          Message[]
  paymentRequests   PaymentRequest[]
  tournamentEntries TournamentParticipant[]
}

/// Demande de dépôt/retrait MVola manuelle (le joueur envoie l'argent lui-même
/// via *111# vers le numéro caisse, indique une référence, puis un admin
/// valide — crédite/débite alors réellement le portefeuille).
model PaymentRequest {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  type       String // deposit | withdraw
  amount     Decimal
  reference  String? // référence MVola ou note fournie par le joueur
  phone      String?
  status     String    @default("pending") // pending | approved | rejected
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?
}

model Wallet {
  id      String        @id @default(cuid())
  user    User?         @relation(fields: [userId], references: [id])
  userId  String?       @unique
  balance Decimal       @default("0")
  txns    Transaction[]
}

model Transaction {
  id        String   @id @default(cuid())
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  walletId  String
  amount    Decimal
  type      String // deposit | withdraw | bet | payout | fee
  meta      String?
  createdAt DateTime @default(now())
}

model Game {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  matches   Match[]
}

model Match {
  id        String       @id @default(cuid())
  game      Game         @relation(fields: [gameId], references: [id])
  gameId    String
  state     String
  betAmount Decimal      @default("0")
  winnerId  String?
  createdAt DateTime     @default(now())
  players   GamePlayer[]
}

model GamePlayer {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  match   Match  @relation(fields: [matchId], references: [id])
  matchId String
  side    String
}

model Tournament {
  id           String                  @id @default(cuid())
  name         String
  entryFee     Decimal
  startsAt     DateTime
  createdAt    DateTime                @default(now())
  participants TournamentParticipant[]
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  joinedAt     DateTime   @default(now())

  @@unique([tournamentId, userId])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  content   String
  createdAt DateTime @default(now())
}
